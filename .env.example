# Strapi API access (read-only lookups in Phase 1; will need write scope in Phase 2)
STRAPI_API_URL=https://aikyamjobs.org/api
STRAPI_API_TOKEN=

# Local server port
PORT=4100

# Path to the claude CLI binary. Usually just "claude" if it's on PATH.
CLAUDE_BIN=claude
# Optional: defaults are opus / medium (drafts don't need deep thinking)
# CLAUDE_MODEL=opus
# CLAUDE_EFFORT=medium

# Chrome used by the Quality tab's Lighthouse audits. Leave unset if Google
# Chrome is installed normally. Otherwise point at Chrome for Testing — the
# real binary inside the .app, not a symlink (see MAC_MINI_SETUP.md):
# CHROME_PATH=/Users/<you>/.local/share/chrome-for-testing/chrome/mac_arm-<ver>/chrome-mac-arm64/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing
